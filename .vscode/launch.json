{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate architecture docs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/gen_docs.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "macroscan.b_ingest.b4_run",
      "args": ["-v", "ingest"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Ingest (pick indicator)",
      "type": "debugpy",
      "request": "launch",
      "module": "macroscan.b_ingest.b4_run",
      "args": ["-v", "ingest", "--only", "${input:indicator}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/src/macroscan/d_visualization/d2_app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "indicator",
      "type": "promptString",
      "description": "Indicator or indicator/frequency, e.g. Real GDP or Real GDP/Q"
    }
  ]
}
