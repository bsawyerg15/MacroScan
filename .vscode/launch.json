{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate architecture docs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/gen_docs.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/src/macroscan/d_visualization/d2_app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
