   {
    "id": "CL_FREQ",
    "name": "Code list for concept \"Frequency\"",
    "description": "This code list provides a set of values indicating\n\t\t\t\t\tthe \"frequency\" of the data (e.g. weekly, monthly, quarterly). The concept\n\t\t\t\t\t\"frequency\" may refer to various stages in the production process, e.g. data\n\t\t\t\t\tcollection or data dissemination. For example, a time series could be\n\t\t\t\t\tdisseminated at annual frequency but the underlying data are compiled monthly.\n\t\t\t\t\tThe code list is applicable for all different uses of\n\t\t\t\t\t\"frequency\".",
    "version": "2.1",
    "agencyID": "SDMX",
    "isExternalReference": false,
    "isPartial": false,
    "codes": [
     {
      "id": "A",
      "name": "Annual",
      "description": "To be used for data collected or disseminated\n\t\t\t\t\t\tevery year"
     },
     {
      "id": "Q",
      "name": "Quarterly",
      "description": "To be used for data collected or disseminated\n\t\t\t\t\t\tevery quarter"
     },
     {
      "id": "N",
      "name": "Minutely",
      "description": "While N denotes \"minutely\", usually, there may be\n\t\t\t\t\t\tno observations every minute (for several series the frequency is usually\n\t\t\t\t\t\t\"irregular\" within a day/days). And though observations may be sparse (not\n\t\t\t\t\t\tcollected or disseminated every minute), missing values do not need to be\n\t\t\t\t\t\tgiven for the minutes when no observations exist: in any case the time stamp\n\t\t\t\t\t\tdetermines when an observation is observed"
     },
     {
      "id": "_Z",
      "name": "Not applicable",
      "description": "To be used when the qualitative or quantitative\n\t\t\t\t\t\tvalues that a variable takes in a data set is not associated to multiple\n\t\t\t\t\t\toccurrences (only single occurrence exists) one can use the _Z as\n\t\t\t\t\t\tfrequency"
     }
    ]
   },
